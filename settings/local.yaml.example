# Local Settings Override Example
# Copy this file to local.yaml and customize for your local development environment.
# local.yaml is gitignored and will not be committed.

# Example: Enable verbose logging locally
# verbose: true

# Example: Use more test workers
# test_workers: 8

# Example: Skip hooks during rapid development
# skip_hooks: true

# Example: Enable AI debugging
# ai_debug: true
# ai_debug_verbose: true

# Example: Enable dashboard
# dashboard_enabled: true
# dashboard_port: 8678

# Example: publish to a private package index (e.g. GitLab PyPI, devpi,
# AWS CodeArtifact, etc.) instead of PyPI. When set, --publish-url is
# passed to `uv publish` and token auth is used (OIDC trusted publishing
# is disabled). All keys live under the `publishing:` block — the flat
# top-level form (publish_version, bump_version, etc.) is silently
# ignored by the Oneiric loader.
#
# publishing:
#   publish_url: "https://gitlab.com/api/v4/projects/<id>/packages/pypi/upload"
#   no_git_tags: false
#   skip_version_check: false
